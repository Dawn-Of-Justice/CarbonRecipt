# Carbon Receipt backend environment variables
# Copy to .env and fill in as needed. The app runs fully with these defaults.

# --- Google Cloud / Vertex AI (Gemini) ---
GOOGLE_CLOUD_PROJECT=gen-ai-academy-491804
GOOGLE_CLOUD_LOCATION=us-central1
GEMINI_MODEL=gemini-2.5-flash

# --- Tier 2 emission-factor API (optional) ---
# If empty, the carbon engine silently skips the Climatiq tier.
CLIMATIQ_API_KEY=

# --- Storage ---
# false = in-memory store (zero setup, good for local dev/demo)
# true  = google-cloud-firestore (needs ADC + Firestore enabled)
USE_FIRESTORE=false
FIRESTORE_DATABASE=(default)
