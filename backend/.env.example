# Carbon Receipt backend environment variables
# Copy to .env and fill in as needed. The app runs fully with these defaults.

# --- Google Cloud / Vertex AI (Gemini) ---
GOOGLE_CLOUD_PROJECT=promptwars-495213
GOOGLE_CLOUD_LOCATION=us-central1
GEMINI_MODEL=gemini-2.5-flash

# --- Tier 2 emission-factor API (optional) ---
# If empty, the carbon engine silently skips the Climatiq tier.
CLIMATIQ_API_KEY=

# --- Storage ---
# false = in-memory store (zero setup, good for local dev/demo)
# true  = google-cloud-firestore (needs ADC + Firestore enabled)
USE_FIRESTORE=false
FIRESTORE_DATABASE=(default)

# --- Security / limits ---
# Max receipt upload size in MB (clamped to 1..25 by the server).
MAX_UPLOAD_MB=10
# Comma-separated list of browser origins allowed via CORS (production frontend URL).
FRONTEND_ORIGIN=http://localhost:3000
# Per-IP requests per minute (0 disables). The expensive limit covers the
# Gemini-backed endpoints (receipt parsing, coach) so the bill stays bounded.
RATE_LIMIT_PER_MINUTE=120
RATE_LIMIT_EXPENSIVE_PER_MINUTE=10
